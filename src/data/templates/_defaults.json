               "perc": -12, "shaker": -13, "tom": -8, "808": -4, "bass": -6, "chords": -8, "melody": -8, "pad": -14,
               "strings": -10, "choir": -12, "pluck": -9, "bell": -11, "counter": -11, "fx": -14, "texture": -18, "vocal": -6},
 "buses": [{"name": "Drums", "roles": ["kick", "snare", "clap", "rim", "hat", "openhat", "ride", "crash", "perc", "shaker", "tom"]},
           {"name": "Music", "roles": ["808", "bass", "chords", "melody", "pad", "strings", "choir", "pluck", "bell", "arp", "counter", "fx", "texture"]},
           {"name": "Vocals", "roles": ["vocal"]}],
 "sends": [{"name": "Reverb", "plugin": "Fruity Reeverb 2"}, {"name": "Delay", "plugin": "Fruity Delay 3"}],
 "master": [{"plugin": "Fruity Parametric EQ 2"}, {"plugin": "Fruity Limiter"}],
 "playlist": ["drums", "bass", "chords", "melody", "fx", "pad", "texture", "vocal"],
 "playlist_names": {"drums": "Drums", "bass": "Bass", "chords": "Chords", "melody": "Melody", "fx": "FX", "pad": "Pad",
                    "texture": "Texture", "vocal": "Vocals", "sections": "Sections"},
 "choices": {
  "sample": [{"sample": "$role"}],
  "808": [{"sample": "808"}, {"plugin": "BooBass", "hint": "BooBass stands in for the 808 (it plays in key): for a real 808 pick one in FLEX, or load a tuned 808 sample"}, {"plugin": "3x Osc", "hint": "a sine-like sub stands in for the 808: for a real 808 pick one in FLEX, or load a tuned 808 sample"}, {"plugin": "Sytrus", "presets": ["*808*", "*sub*bass*"]}],
  "kick": [{"sample": "kick"}, {"plugin": "Fruity Kick"}],
  "bass": [{"flex": "bass"}, {"fl_instrument": "bass", "genres": ["lofi", "jazzhop", "boombap", "rnb", "gospel", "ambient", "cinematic", "pop", "rock", "afrobeats", "kpop", "reggaeton", "dancehall", "amapiano"], "hint": "a recorded bass (FL's own multisample)"}, {"plugin": "BooBass"}, {"plugin": "Sytrus", "presets": ["*bass*"]}, {"plugin": "3x Osc"}],
  "keys": [{"labs": "piano"}, {"flex": "piano"}, {"plugin": "Sytrus", "presets": ["*rhodes*", "*e*piano*", "*wurl*", "*keys*", "*piano*"]}, {"plugin": "FL Keys", "presets": ["*rhodes*", "*e*piano*", "*grand*", "*piano*"]}, {"plugin": "3x Osc"}],
  "pad": [{"labs": "pad"}, {"flex": "pad"}, {"plugin": "Harmor", "presets": ["*pad*"]}, {"plugin": "Harmless", "presets": ["*pad*"]}, {"plugin": "Sytrus", "presets": ["*pad*"]}, {"plugin": "3x Osc", "presets": ["*pad*"]}],
  "lead": [{"labs": "pluck"}, {"plugin": "Harmor", "presets": ["*lead*"]}, {"plugin": "Harmless", "presets": ["*lead*"]}, {"plugin": "Sytrus", "presets": ["*lead*", "*pluck*"]}, {"flex": "lead"}, {"plugin": "3x Osc", "presets": ["*lead*"]}],
  "pluck": [{"labs": "pluck"}, {"flex": "pluck"}, {"plugin": "Sakura", "presets": ["*pluck*", "*harp*"]}, {"plugin": "Harmless", "presets": ["*pluck*"]}, {"plugin": "Sytrus", "presets": ["*pluck*"]}, {"plugin": "Plucked!"}, {"plugin": "3x Osc"}],
  "bell": [{"labs": "bells"}, {"flex": "bells"}, {"plugin": "Sytrus", "presets": ["*bell*", "*glock*", "*music*box*"]}, {"plugin": "Fruity DX10"}, {"plugin": "3x Osc"}],
  "strings": [{"labs": "strings"}, {"flex": "strings"}, {"fl_instrument": "strings"}, {"plugin": "Sytrus", "presets": ["*string*"]}, {"plugin": "3x Osc", "presets": ["*string*"]}],
  "choir": [{"labs": "choir"}, {"flex": "choir"}, {"plugin": "Sytrus", "presets": ["*choir*", "*vox*", "*pad*"]}, {"fl_instrument": "choir"}, {"plugin": "3x Osc", "presets": ["*choir*", "*pad*"]}],
  "guitar": [{"labs": "guitar"}, {"flex": "guitar"}, {"fl_instrument": "guitar"}, {"plugin": "Sakura", "presets": ["*guitar*"]}, {"plugin": "Plucked!"}, {"plugin": "3x Osc"}],
  "synth": [{"plugin": "Harmor", "presets": ["*synth*", "*lead*"]}, {"plugin": "Harmless", "presets": ["*synth*", "*lead*"]}, {"plugin": "Sytrus", "presets": ["*synth*", "*lead*"]}, {"flex": "synth"}, {"plugin": "3x Osc"}],
  "organ": [{"flex": "organ"}, {"plugin": "Sytrus", "presets": ["*b3*", "*hammond*", "*drawbar*", "*organ*"]}, {"plugin": "FL Keys", "presets": ["*organ*"]}, {"plugin": "3x Osc"}],
  "brass": [{"labs": "brass"}, {"flex": "brass"}, {"fl_instrument": "brass"}, {"plugin": "Sytrus", "presets": ["*brass*", "*horn*"]}, {"plugin": "Fruity DX10"}, {"plugin": "3x Osc"}]
 },
 "character": "a channel's \"character\": {query: words, avoid: [phrases]} - the sound it should have ('felt rhodes soft tape', avoid 'electric grand'): every LABS / FLEX / plugin-preset / FL instrument choice of the chain ranks by these words unless the choice has its own query / avoid. FLEX ranks by pack quality too (data/flex/quality.json): Core / Essential packs up, General MIDI style packs only as a last resort - kept back while any real sound of the chain is left, used only before a synth's raw init patch / 3x Osc. Several {flex: kind} choices in one chain (trap bells: bells, then pluck, then keys) are tried in order.",
 "choices_order": "free plugins anyone can have first (LABS / INSTRUMENT, then FLEX), then higher-tier FL plugins (used only when the FL edition or the profile says they are owned: a demo plugin is never put in a song), then Producer-tier Sytrus, then stock plugins every edition has (FL Keys, BooBass, Plucked!, Fruity DX10, 3x Osc) and FL's own instruments, so a bare FL of any edition still gets a real sound. Preset globs are guesses at factory names: no match = the plugin's default patch, said in the result.",
 "icons": "symbolic names only (e.g. 'kick'); numbers come from data/templates/_icons.json once verified on a PC"
}
