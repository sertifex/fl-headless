  "pad": "#45325F", "strings": "#5A3D2A", "choir": "#4A3570", "pluck": "#25524A", "bell": "#2F4F5F", "arp": "#2E4E3E",
  "counter": "#2E4A5A", "fx": "#5A4F1E", "texture": "#3A3A3A", "vocal": "#5E2A48",
  "bus": {"Drums": "#4A2020", "Music": "#20304A", "Vocals": "#4A2040"},
  "send": "#2E2E3E",
