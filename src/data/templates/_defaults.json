{
 "format": "flh-template-defaults/1",
 "about": "Shared defaults for data/templates/<genre>.json recipes (fl-headless's own data). A genre recipe overrides any key; a channel entry overrides its role's defaults. Users can override files in <fl-headless state folder>/templates/*.json.",
 "palette": {
  "kick": "#5C2626", "snare": "#5C3626", "clap": "#5C4426", "rim": "#5C3020", "hat": "#4E5226", "openhat": "#3F5226",
