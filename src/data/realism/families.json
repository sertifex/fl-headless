   "velocity": {"arc": 8, "accent_first": 5, "spread": 4, "contour": 4},
   "natural": {"note_len_s": [0.03, 8.0], "timing_spread_ms": [1, 10], "expression_move": [0, 1]}
  },
  "pluck": {
   "describe": "harp / guitar / plucked synths: small hand spread, velocity phrasing, no swells",
   "expression": {"use": false},
   "timing": {"late_ms": [0, 3], "register_ms_per_octave": 0, "spread_ms": 4, "max_shift_ms": 12, "roll": false},
   "lengths": {"breath": false, "legato": false, "release_restart_ms": 15, "touch_gap_beats": 0, "phrase_end_shorten": 0.0},
   "velocity": {"arc": 8, "accent_first": 6, "spread": 5, "contour": 4},
   "natural": {"note_len_s": [0.03, 8.0], "timing_spread_ms": [1, 15], "expression_move": [0, 1]}
  },
  "pad": {
   "describe": "pads: subtle - a slow swell into each chord, gentle release, almost no timing change",
   "expression": {"use": true, "floor": 0.4, "ceiling": 0.92, "level": [0.55, 0.85], "swell_min_beats": 2.0, "swell_beats": [0.5, 2.0], "swell_depth": 0.1,
                  "bow_arc": 0.03, "arc": 0.08, "end_decay": 0.12, "contour": 0.0, "micro": 0.01, "pre_beats": 0.25,
                  "expression_level": [0.85, 0.97], "expression_end_fade": 0.08},
