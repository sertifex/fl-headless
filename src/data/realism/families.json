               "release_restart_ms": 35, "legato": true, "legato_overlap_ms": 30, "legato_max_gap_beats": 0.2,
               "touch_gap_beats": 0.1, "phrase_end_shorten": 0.15},
   "velocity": {"arc": 10, "accent_first": 9, "spread": 5, "contour": 5},
   "natural": {"note_len_s": [0.08, 8.0], "timing_spread_ms": [2, 20], "expression_move": [0.03, 0.4]}
  },
  "winds": {
   "describe": "woodwinds: legato lines on one breath, breaths at phrase ends and inside long phrases, gentle swells",
   "expression": {"use": true, "floor": 0.18, "ceiling": 0.95, "level": [0.38, 0.82], "swell_min_beats": 1.0, "swell_beats": [0.3, 1.25], "swell_depth": 0.18,
                  "bow_arc": 0.05, "arc": 0.18, "end_decay": 0.2, "contour": 0.08, "micro": 0.02, "pre_beats": 0.125,
