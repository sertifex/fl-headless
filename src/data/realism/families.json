  },
  "brass": {
   "describe": "tongued attacks (on time, a firmer start), crescendos into peaks, shorter phrase ends, breaths",
   "expression": {"use": true, "floor": 0.2, "ceiling": 0.97, "level": [0.4, 0.86], "swell_min_beats": 1.5, "swell_beats": [0.25, 1.0], "swell_depth": 0.14,
                  "bow_arc": 0.05, "arc": 0.2, "end_decay": 0.16, "contour": 0.08, "micro": 0.02, "pre_beats": 0.125,
