 "fallback": {
  "_about": "when a channel has no controller the engine can automate: velocities carry the phrase shape (scaled) and, if volume is on, the channel's volume knob follows the expression curve below the level the user set (never louder)",
  "velocity_scale": 2.0, "volume": true, "volume_depth": 0.35
 },
 "articulations": {
  "_about": "per-section articulation choice: first rule whose conditions hold (families: which families it applies to). median_len_s / density (notes per second) / repeat_fast (share of notes repeating the same pitch within repeat_ms) / vel (median velocity 0-127) / energy (0..1 section energy)",
  "repeat_ms": 140,
  "rules": [
   {"name": "tremolo", "families": ["strings"], "when": {"repeat_fast_min": 0.5}},
   {"name": "pizz", "families": ["strings"], "when": {"median_len_s_max": 0.3, "vel_max": 72, "density_max": 6}},
   {"name": "short", "families": ["strings", "brass", "winds", "choir"], "when": {"median_len_s_max": 0.3}},
   {"name": "swell", "families": ["strings", "brass", "winds", "choir"], "when": {"median_len_s_min": 3.0, "density_max": 0.8, "energy_max": 0.35}},
   {"name": "long", "families": ["strings", "brass", "winds", "choir", "pad"], "when": {}}
  ]
 }
}
