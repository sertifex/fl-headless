{
 "_about": "flh_realism rules per instrument family: how a player of that family shapes dynamics, timing and note lengths. Times in ms or seconds, lengths in beats, controller values 0..1 (FL automation range). amount (0..1) scales every deviation. Users override any key with <fl-headless state folder>/realism/families.json (merged over this file).",
 "version": 1,
 "amount_by_genre": {
  "_about": "default amount when the call gives none: first regex that matches the song's genre/style text (journal genre + style + project genre), else default",
  "rules": [
   ["orchestral|cinematic|film|score|classical|trailer|epic", 0.9],
   ["ballad|piano|neo.?classical|ambient|post.?rock|folk|acoustic|gospel|soul", 0.8],
   ["jazz|rnb|r&b|lofi|lo-fi|indie|singer", 0.7],
   ["pop|kpop|rock|country|afrobeats|reggaeton|dancehall", 0.55],
   ["edm|house|techno|trance|dnb|drum.?and.?bass|dubstep|trap|drill|phonk|hyperpop|synthwave|amapiano|jersey|club|hip.?hop|boombap", 0.4]
  ],
  "default": 0.65,
  "min": 0.0,
  "max": 1.0
 },
 "aliases": {
  "string": "strings", "violin": "strings", "viola": "strings", "cello": "strings", "contrabass": "strings",
  "voice": "choir", "voices": "choir", "vocals_ensemble": "choir",
  "woodwind": "winds", "woodwinds": "winds", "wind": "winds", "flute": "winds", "reed": "winds",
  "horn": "brass", "trumpet": "brass", "trombone": "brass",
  "percussion": "timpani", "perc": "timpani", "drum": "timpani",
  "bells": "mallets", "bell": "mallets", "glock": "mallets", "celesta": "mallets",
  "guitar": "pluck", "harp": "pluck", "plucked": "pluck", "arp": "pluck",
  "synth": "synth", "lead": "lead", "pad": "pad", "bass": "bass"
 },
 "skip": {
  "_about": "families left exactly as played by flp_realism's channel auto-pick (a piano is performed by its player; drums have their own groove tools)",
  "families": ["keys", "drums", "vocal"],
  "auto_skip": ["bass", "lead"]
 },
 "detect": {
  "_about": "text rules (channel name, preset name/family/tags, journal role) -> family; first match wins; tried before the score's instrument guess",
  "rules": [
   ["\\b(timpani|timps?)\\b", "timpani"],
   ["\\b(choir|choral|chorus voices?|voices|vocal ensemble|ahh?s?|oohs?|soprano|alto|tenor|bass voice|mezzo|singers)\\b", "choir"],
   ["\\b(strings?|violins?|violas?|cellos?|celli|contrabass|double bass|fiddle|string ensemble|spiccato|pizz|tremolo strings)\\b", "strings"],
   ["\\b(brass|horns?|french horn|trumpets?|trombones?|tuba|euphonium|flugel\\w*|cornet)\\b", "brass"],
   ["\\b(woodwinds?|winds|flutes?|piccolo|oboes?|clarinets?|bassoons?|cor anglais|english horn|recorder|whistle|ocarina|sax\\w*|pan ?flute|shakuhachi)\\b", "winds"],
   ["\\b(glock\\w*|celest[ae]|crotales|vibraphone|vibes|marimba|xylophone|tubular bells|bells?|music box|kalimba)\\b", "mallets"],
   ["\\b(harp|guitar|nylon|pluck\\w*|mandolin|ukulele|banjo|koto|sitar|arp\\w*)\\b", "pluck"],
   ["\\b(pads?|drone|atmos\\w*|texture|wash|ambien\\w*|evolving)\\b", "pad"],
   ["\\b(piano|grand|upright|keys|rhodes|wurli\\w*|electric piano|epiano|organ|harpsichord|clav\\w*)\\b", "keys"],
   ["\\b(drums?|kick|snare|hats?|hi-?hat|clap|cymbal|808 kit|fpc|toms?)\\b", "drums"],
   ["\\b(sub ?bass|808|bassline|synth bass|bass)\\b", "bass"],
   ["\\b(lead|vocal|vox|topline)\\b", "lead"],
   ["\\b(synth|saw|square|supersaw|serum|vital|sytrus|harmor|flex)\\b", "synth"]
  ],
  "instrument_family": {
   "_about": "score instrument entry (data/instrument_ranges.json) family/id -> realism family",
   "strings": "strings", "voice": "choir", "brass": "brass", "woodwind": "winds", "wind": "winds",
   "percussion": "timpani", "mallets": "mallets", "keys": "keys", "plucked": "pluck", "synth": "synth", "bass": "bass"
  },
  "instrument_id": {"timpani": "timpani", "vocal": "vocal", "pad": "pad", "pluck": "pluck", "arp": "pluck", "bell": "mallets",
                    "lead": "lead", "chords": "synth", "sub bass": "bass", "808": "bass", "synth bass": "bass", "drums": "drums"},
  "role": {"pad": "pad", "drums": "drums"}
 },
 "phrase": {
  "_about": "a phrase ends where the part rests at least gap_beats (or gap_ms, the larger) or at a section boundary; very long phrases are split at their largest inner gap",
  "gap_beats": 0.75, "gap_ms": 220, "max_beats": 32
 },
 "families": {
  "strings": {
   "describe": "a bowed section: dynamics swell into long notes, bow arcs, slightly late speaking attacks spread across the section, connected lines",
   "expression": {"use": true, "floor": 0.18, "ceiling": 0.95, "level": [0.38, 0.82], "swell_min_beats": 1.0, "swell_beats": [0.35, 1.5], "swell_depth": 0.22,
                  "bow_arc": 0.06, "arc": 0.18, "end_decay": 0.22, "contour": 0.06, "micro": 0.025, "pre_beats": 0.25,
                  "expression_level": [0.8, 0.97], "expression_end_fade": 0.12},
   "timing": {"late_ms": [6, 22], "register_ms_per_octave": 3.0, "spread_ms": 5, "max_shift_ms": 35, "roll": false},
   "lengths": {"breath": false, "breath_ms": 0, "max_breath_s": null, "max_sustain_s": null, "rearticulate_ms": 0,
               "release_restart_ms": 25, "legato": true, "legato_overlap_ms": 45, "legato_max_gap_beats": 0.25,
               "touch_gap_beats": 0.125, "phrase_end_shorten": 0.0},
   "velocity": {"arc": 10, "accent_first": 5, "spread": 4, "contour": 4},
   "natural": {"note_len_s": [0.12, 12.0], "timing_spread_ms": [3, 30], "expression_move": [0.04, 0.45]}
  },
  "choir": {
   "describe": "singers: soft swelling attacks, breaths between phrases (the note before a breath gets shorter), long notes need a catch breath",
   "expression": {"use": true, "floor": 0.15, "ceiling": 0.92, "level": [0.35, 0.8], "swell_min_beats": 0.75, "swell_beats": [0.5, 1.75], "swell_depth": 0.26,
                  "bow_arc": 0.05, "arc": 0.2, "end_decay": 0.28, "contour": 0.07, "micro": 0.02, "pre_beats": 0.25,
                  "expression_level": [0.8, 0.96], "expression_end_fade": 0.15},
   "timing": {"late_ms": [10, 28], "register_ms_per_octave": 1.5, "spread_ms": 7, "max_shift_ms": 40, "roll": false},
   "lengths": {"breath": true, "breath_ms": 260, "max_breath_s": 9.0, "max_sustain_s": 10.0, "rearticulate_ms": 220,
               "release_restart_ms": 40, "legato": true, "legato_overlap_ms": 40, "legato_max_gap_beats": 0.25,
               "touch_gap_beats": 0.125, "phrase_end_shorten": 0.0},
