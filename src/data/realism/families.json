               "release_restart_ms": 30, "legato": true, "legato_overlap_ms": 35, "legato_max_gap_beats": 0.25,
               "touch_gap_beats": 0.125, "phrase_end_shorten": 0.06},
   "velocity": {"arc": 8, "accent_first": 5, "spread": 4, "contour": 5},
   "natural": {"note_len_s": [0.08, 9.0], "timing_spread_ms": [2, 25], "expression_move": [0.03, 0.4]}
  },
  "timpani": {
   "describe": "timpani / orchestral percussion: no drift, hits stay on the beat; fast repeated notes become a roll (hand-to-hand velocity, tiny spread, swelling)",
   "expression": {"use": false},
   "timing": {"late_ms": [0, 0], "register_ms_per_octave": 0, "spread_ms": 0, "max_shift_ms": 4, "roll": true, "roll_ioi_ms": 170,
              "roll_spread_ms": 2.5, "roll_hand_vel": 5, "roll_swell_vel": 14},
   "lengths": {"breath": false, "legato": false, "release_restart_ms": 0, "touch_gap_beats": 0, "phrase_end_shorten": 0.0},
   "velocity": {"arc": 6, "accent_first": 6, "spread": 3, "contour": 0},
   "natural": {"note_len_s": [0.03, 6.0], "timing_spread_ms": [0, 6], "expression_move": [0, 1]}
  },
  "mallets": {
   "describe": "bells / mallets / celesta: struck, so timing stays tight; gentle velocity phrasing only",
   "expression": {"use": false},
   "timing": {"late_ms": [0, 0], "register_ms_per_octave": 0, "spread_ms": 2, "max_shift_ms": 6, "roll": true, "roll_ioi_ms": 120,
