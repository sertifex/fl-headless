{
 "_about": "Instrument ranges for fl-headless (flh_score range / register checks). All pitches are SOUNDING (concert) pitch, note names with C4 = 60 = middle C (FL's piano roll labels middle C as C5). range = lowest-highest note the instrument (or a typical sample library of it) can play; good = where it sounds full and idiomatic (outside it the note is thin, strained or muddy, but playable). uncertain: true = from general orchestration knowledge; the exact sampled range of a library was not verified. match = case-insensitive regular expressions tried, in list order (first hit wins, so specific names come before general ones), on the journal's instrument/role, the channel name, the plugin preset name/family/tags and the plugin name. kind: pitched (default) | drums (no pitch checks). Extend or override it with <fl-headless state folder>/score/instrument_ranges.json (same format; its entries win).",
 "version": 1,
 "instruments": [
  {"id": "drums", "kind": "drums", "match": ["\\bkick", "\\bsnare", "hi-?hat|\\bhats?\\b", "\\bclap", "\\bdrum(?!.*(steel|melodic))", "\\bdrums\\b", "(?<!tuned )\\bperc(ussion)?\\b", "untuned percussion", "\\bcymbal", "\\bride\\b", "\\bcrash\\b", "\\btoms?\\b", "\\bshaker", "tambourine|\\btamb\\b", "\\brim(shot)?\\b", "\\bconga|\\bbongo|\\bcajon|\\btaiko|\\bdjembe", "\\bfpc\\b", "808 ?(kit|drums)", "\\bbreak(beat)?s?\\b", "woodblock|agogo|reverse cymbal|gong|tam-?tam|bass drum|snare drum|side drum|triangle"]},
  {"id": "timpani", "match": ["timpani", "\\btimp\\b", "kettle ?drum"], "range": ["C2", "C4"], "good": ["D2", "A3"], "family": "percussion", "uncertain": true, "note": "a standard set of 4 pedal drums covers D2-A3; a 32\" drum reaches C2 and a piccolo drum C4. BBC SO Discover and most libraries sample roughly D2-C4: check the library's keyboard range on the PC"},
  {"id": "glockenspiel", "match": ["glockenspiel", "\\bglock\\b"], "range": ["G5", "C8"], "good": ["G5", "C8"], "family": "mallets", "note": "sounds two octaves above written"},
  {"id": "crotales", "match": ["crotales?"], "range": ["C6", "C8"], "good": ["C6", "C8"], "family": "mallets", "uncertain": true},
  {"id": "xylophone", "match": ["xylophone", "\\bxylo\\b"], "range": ["F4", "C8"], "good": ["F4", "C8"], "family": "mallets", "note": "sounds an octave above written"},
  {"id": "marimba", "match": ["marimba"], "range": ["A1", "C7"], "good": ["C2", "C7"], "family": "mallets"},
  {"id": "vibraphone", "match": ["vibraphone", "\\bvibes?\\b"], "range": ["F3", "F6"], "good": ["F3", "F6"], "family": "mallets"},
  {"id": "tubular bells", "match": ["tubular ?bells?", "\\bchimes\\b"], "range": ["C4", "F5"], "good": ["C4", "F5"], "family": "mallets"},
  {"id": "celesta", "match": ["celesta", "celeste"], "range": ["C4", "C8"], "good": ["C4", "C7"], "family": "keys", "note": "sounds an octave above written"},
