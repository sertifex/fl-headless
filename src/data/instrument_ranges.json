  {"id": "steel drums", "match": ["steel ?(drums?|pan)"], "range": ["C4", "E6"], "good": ["C4", "C6"], "family": "mallets", "uncertain": true},
  {"id": "dulcimer", "match": ["dulcimer", "santur", "cimbalom"], "range": ["D3", "E6"], "good": ["D3", "D6"], "family": "plucked", "uncertain": true},
  {"id": "electric piano", "match": ["electric piano", "e\\.? ?piano", "\\bep\\b", "rhodes", "wurli", "\\bfender\\b"], "range": ["E1", "E7"], "good": ["C2", "C6"], "family": "keys"},
